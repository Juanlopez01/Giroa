# =============================================================================
# Giroa: variables de entorno
# Copiá este archivo a .env.local y completalo. Nunca commitees .env.local.
# Las NEXT_PUBLIC_* llegan al navegador: ahí nunca va nada secreto.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Local: valores que imprime `npx supabase status` (API URL y Publishable key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role / secret key. SOLO SERVIDOR: saltea RLS.
# Local: "Secret key" de `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dominios ------------------------------------------------------------------
# Dominio raíz CON puerto si corresponde. Los estudios viven en {slug}.<root>.
# Local: localhost:3000  (abrí http://tango-demo.localhost:3000)
# Producción: giroa.app
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Dominio de la cookie de sesión para compartir el login entre subdominios.
# Producción: .giroa.app   Local: dejalo vacío (cada subdominio tiene su sesión).
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Seguridad -------------------------------------------------------------------
# Clave AES-256-GCM para encriptar los tokens de Mercado Pago (32 bytes base64).
# Generala con: openssl rand -base64 32
# Si la cambiás, los estudios tienen que volver a vincular MP.
TOKEN_ENCRYPTION_KEY=

# Secreto HMAC para firmar el state del OAuth de MP (mínimo 32 caracteres).
# Generalo con: openssl rand -base64 48
OAUTH_STATE_SECRET=

# Secreto que tienen que mandar los crons al llamar a /api/cron/* (mín. 32).
# Generalo con: openssl rand -base64 48
CRON_SECRET=

# --- Mercado Pago (marketplace con OAuth) ------------------------------------------
# Datos de la aplicación de Giroa en https://www.mercadopago.com.ar/developers
# Opcionales hasta la Fase 1 paso 9 (vincular cuenta).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# "Clave secreta" de la sección Webhooks de la aplicación (valida x-signature).
MP_WEBHOOK_SECRET=
